#!/usr/bin/env ruby

require "yaml"
require "open3"
require "optparse"
require "fileutils"

# Use configured projects:
# tproj <- get a list of available projects (configured below)
# tproj project-name <- start or resume a specific project
# tproj project-name -b branch <- same, but in a git worktree for that branch
#
# Use ad-hoc projects:
# tproj ad-hoc-project ~/project/path

# looks in ~/.config/tproj.conf for project configs

# Command tracing, shared by everything here that shells out.
module Trace
  class << self
    attr_accessor :enabled
    alias enabled? enabled

    def echo(cmd, prefix: "$")
      puts "#{prefix} #{Array(cmd).join(' ')}" if enabled?
    end
  end
end

class Project
  OVERWRITEABLE = %w[
    dir
    windows start distrobox detach
    worktree worktrees from_ref
  ]
  DEFAULT_WORKTREES_DIR = "tmp/wt"
  attr_reader :key, :options

  def initialize(key = nil, options)
    @key = key
    @options = options
  end

  def apply(other_options)
    OVERWRITEABLE.each do |key|
      options[key] = other_options[key] if other_options.key?(key)
    end
  end

  # the repository/project checkout, ignoring any requested worktree
  def project_dir
    File.expand_path(options.fetch("dir") { Dir.pwd })
  end

  def dir
    worktree? ? worktree_dir : project_dir
  end

  def worktree
    options["worktree"]
  end

  def worktree?
    !worktree.to_s.empty?
  end

  # relative paths are resolved against the project directory
  def worktrees_dir
    configured = options["worktrees"] || DEFAULT_WORKTREES_DIR
    File.expand_path(configured, project_dir)
  end

  def worktree_dir
    File.join(worktrees_dir, path_safe(worktree))
  end

  # ref a newly created worktree branch starts from
  def from_ref
    options["from_ref"]
  end

  def abbr
    @abbr ||= options.fetch("abbr") { rand(0..0xffff).to_s(16) }
  end

  # tmux session name, kept distinct per worktree
  def session
    return abbr unless worktree?

    # tmux session names can't have dots (or :, but they don't survive path_safe)
    path_safe(worktree).tr(".", "_")
  end

  def names
    [abbr, key, *options.fetch("names", [])].compact.uniq
  end

  def windows
    [
      options.fetch("windows") { 1 },
      commands.count,
      labels.count
    ].max
  end

  def commands
    options.fetch("commands") { [] }
  end

  def labels
    options.fetch("labels") { [] }
  end

  def start
    options.fetch("start") { false }
  end

  def attach?
    !options["detach"]
  end

  def flake?
    options["flake"]
  end

  def tmux_cmd(*args)
    return nix_shell_tmux(*args) if options["flake"]

    box = options.fetch("distrobox", "")
    return ["tmux", *args].join(" ") if box.empty?

    tmux_parts = ["tmux -S ~/.local/share/tmux-#{box}.sock", *args].join(" ")
    "distrobox-enter #{box} -- #{tmux_parts}"
  end

  def nix_shell_tmux(*args)
    [
      "nix", "shell",
      %{--file "#{File.join(dir, 'flake.nix')}"},
      "--command tmux", *args
    ].join(" ")
  end

  # branch names may contain characters that are illegal in (or imply nested)
  # path names, so flatten them all down to underscores
  def path_safe(name)
    name.gsub(%r{[^A-Za-z0-9._-]}, "_").sub(/\A[.-]+/) { |run| "_" * run.length }
  end
end

# The configured projects, read from the YAML configs and looked up by name.
class ProjectRegistry
  CONFIG      = "~/.config/tproj.yml"
  HOST_CONFIG = "~/.config/tproj.%s.yml"

  # Project abbrs are randomized when unconfigured, so everything that asks for
  # a project has to be looking at the same instances.
  def self.default
    @default ||= new
  end

  def projects
    @projects ||= configs.map { |key, config| Project.new(key, config) }
  end

  def find(name)
    projects.find { |project| project.names.member?(name) }
  end

  def abbrs
    projects.map(&:abbr)
  end

  def configs
    config_paths.map { |path| YAML.load_file(path) }.reduce({}, :merge)
  end

  # listed by precedence, ascending
  def config_paths
    [CONFIG, HOST_CONFIG % host]
      .map { |path| File.expand_path(path) }
      .select { |path| File.exist? path }
  end

  def host
    File.read('/etc/hostname').strip
  rescue Errno::ENOENT
    require 'socket'
    Socket.gethostname
  end
end

# git queries scoped to one checkout
class Git < Struct.new(:dir)
  def call(*args)
    cmd = ["git", "-C", dir, *args]
    Trace.echo(cmd)
    stdout, stderr, status = Open3.capture3(*cmd)
    [stdout.strip, stderr.strip, status.success?]
  end

  def repo?
    ref_exists?("HEAD")
  end

  def ref_exists?(ref)
    call("rev-parse", "--verify", "--quiet", ref).last
  end

  def branch_exists?(branch)
    ref_exists?("refs/heads/#{branch}")
  end

  def remote_branch_exists?(branch)
    call("for-each-ref", "--format=%(refname)", "refs/remotes/*/#{branch}").first.split("\n").any?
  end

  # Primary branch for the repo: what origin points its HEAD at, else the first
  # conventional name that exists locally, else whatever the checkout is on.
  def main_branch
    head, _stderr, success = call("symbolic-ref", "--short", "refs/remotes/origin/HEAD")
    return head.split("/", 2).last if success && !head.empty?

    conventional = %w[main master trunk].find { |name| branch_exists?(name) }
    return conventional if conventional

    current, _stderr, success = call("rev-parse", "--abbrev-ref", "HEAD")
    success && !current.empty? ? current : "HEAD"
  end
end

# The git worktree a project was asked to run in, if any.
class Worktree < Struct.new(:project)
  # Ensure the worktree for the requested branch exists, creating the branch too
  # when it is not already known locally or on a remote.
  def prepare
    return unless project.worktree?
    return if Dir.exist?(dir)

    abort "Not a git repository: #{root}" unless git.repo?

    FileUtils.mkdir_p(File.dirname(dir))

    _stdout, stderr, success = git.call(*add_args)
    abort "Could not start worktree for #{branch}:\n#{stderr}" unless success
    puts "Started worktree for #{branch} at #{dir}"
  end

  def branch
    project.worktree
  end

  def dir
    project.worktree_dir
  end

  def root
    project.project_dir
  end

  def git
    @git ||= Git.new(root)
  end

  def known?
    git.branch_exists?(branch) || git.remote_branch_exists?(branch)
  end

  def add_args
    return ["worktree", "add", dir, branch] if known?

    from_ref = project.from_ref.to_s
    from_ref = git.main_branch if from_ref.empty?
    ["worktree", "add", "-b", branch, dir, from_ref]
  end
end

# The tmux session for a project: resume it if it is already up, otherwise build
# it out window by window and attach.
class Session < Struct.new(:project)
  def call
    set_terminal_title("tmux: #{project.session}")

    # replaces this process, so execution stops there
    attach if running?

    Worktree.new(project).prepare

    build
    run project.tmux_cmd("select-window -t #{project.session}:1")

    attach if project.attach?
  end

  def running?
    existing_sessions.member?(project.session)
  end

  def existing_sessions
    cmd = project.tmux_cmd("list-sessions")
    Trace.echo(cmd)
    stdout, stderr, status = Open3.capture3(cmd)
    return stdout.split("\n").map { |line| line.split(":").first } if status.success?

    puts "Error: #{stderr}"
    []
  end

  def attach
    cmd = project.tmux_cmd("attach -t #{project.session}")
    Trace.echo(cmd, prefix: ">")
    exec cmd
  end

  def build
    run project.tmux_cmd("new -s #{project.session} -c #{project.dir} -d")

    delayed = []
    1.step(to: project.windows) do |n|
      cmd, label = project.commands[n - 1], project.labels[n - 1]
      run project.tmux_cmd("new-window -t #{project.session} -c #{project.dir}") unless n == 1
      delayed << send_keys_cmd(n, cmd) if cmd
      run project.tmux_cmd("rename-window -t #{project.session}:#{n}", label) if label
    end

    return if delayed.empty?

    sleep 1 # give shell a chance so prompt is drawn before keys
    delayed.each { |cmd| system(cmd) }
  end

  def send_keys_cmd(window, cmd)
    parts = ["send-keys", "-t", "#{project.session}:#{window}", keys_escape(cmd)]
    parts << "Enter" if project.start

    project.tmux_cmd(*parts).tap { |full| Trace.echo(full, prefix: "DELAYED$") }
  end

  # Convert a command into a set of tmux send-keys values
  def keys_escape(cmd)
    # encapsulate in quotes and quote existing quotes
    cmd.inspect
  end

  def set_terminal_title(title)
    print "\033]0;#{title}\007"
  end

  def run(cmd)
    Trace.echo(cmd)
    system cmd
  end
end

class Script < Struct.new(:options)
  def self.parse_options(argv)
    options = {}

    args = OptionParser.new do |op|
      op.banner = "Usage: tproj [options] [project_name] [dir]"

      op.on("-a ABBR", "--abbr ABBR", "Abbreviation for project. Used as tmux session name.") do |abbr|
        options["abbr"] = abbr
      end

      op.on("-d DIR", "--dir DIR", "Project working directory") do |dir|
        options["dir"] = dir
      end

      op.on("-w WINDOWS", "--windows WINDOWS", Integer, "Number of tmux windows in project") do |windows|
        options["windows"] = [windows, 1].max
      end

      op.on("-b BRANCH", "--worktree BRANCH", "Create/switch to a git worktree for BRANCH and session it there") do |branch|
        options["worktree"] = branch
      end

      op.on("--worktrees-dir DIR", "Where worktrees live (default: #{Project::DEFAULT_WORKTREES_DIR}, relative to the project dir)") do |dir|
        options["worktrees"] = dir
      end

      op.on("--from-ref REF", "When creating a new worktree+branch, the branch/ref to branch from") do |ref|
        options["from_ref"] = ref
      end

      op.on("--[no-]start", "Overrides project start option for pre-filled commands") do |start|
        options["start"] = start
      end

      op.on("-x [DISTROBOX]", "--distrobox [DISTROBOX]", "Create tmux session within specified distrobox. If blank, run on host (no distrobox).") do |distrobox|
        options["distrobox"] = distrobox
      end

      op.on("--detach", "Do not attach to the created tmux session") do
        options["detach"] = true
      end

      op.on("--flake", "Attempt to use flake.nix inside project directory via nix shell") do
        options["flake"] = true
      end

      op.on("--debug", "Enable debug output") do
        Trace.enabled = true
      end

      # useful if session needs to wait for difficult to status services
      op.on("--delay SECONDS", Float, "Number of seconds to wait before starting session") do |seconds|
        sleep seconds
      end

      op.on("-h", "--help") do
        puts op
        example_usage
      end
    end.parse(argv)

    options["abbr"] = args.shift if args.any? && !options["abbr"]
    options["dir"] = args.shift if args.any? && !options["dir"]

    self.new options
  end

  def self.example_usage
    puts <<~HELPTEXT
      Examples:

        $ tproj project-name
        $ tproj abbr path/to/project
        $ tproj --distrobox=arch-asdf --windows=5 my-project
        $ tproj --abbr=acab --dir=projects/police-brutality --windows=2
        $ tproj dotbox --worktree=feature/thing
        $ tproj dotbox -b bugfix --worktrees-dir=~/worktrees/dotbox

      Pre-configured projects: #{ProjectRegistry.default.abbrs.join(', ')}
    HELPTEXT
    exit
  end

  def call
    project = find_or_create_project
    self.class.example_usage unless project
    project.apply(options)

    Session.new(project).call
  end

  def find_or_create_project
    return unless options["abbr"]

    # see if it already exists
    if (project = registry.find(options["abbr"]))
      project.apply(options) # merge stored config with any runtime options
      return project
    end

    # if we have any of these options besides just abbr
    Project.new(options) if %w[dir distrobox windows worktree].any? { |key| options[key] }
  end

  def registry
    ProjectRegistry.default
  end
end

Script.parse_options(ARGV).()
