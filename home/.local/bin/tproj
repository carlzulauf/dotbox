#!/usr/bin/env ruby

require "yaml"
require "open3"
require "optparse"
require "fileutils"

# Use configured projects:
# tproj <- get a list of available projects (configured below)
# tproj project-name <- start or resume a specific project
# tproj project-name -b branch <- same, but in a git worktree for that branch
#
# Use ad-hoc projects:
# tproj ad-hoc-project ~/project/path

# looks in ~/.config/tproj.conf for project configs

$debug = false

class Project
  OVERWRITEABLE = %w[
    dir
    windows start distrobox detach
    worktree worktrees from_ref
  ]
  DEFAULT_WORKTREES_DIR = "tmp/wt"
  attr_reader :key, :options

  def initialize(key = nil, options)
    @key = key
    @options = options
  end

  def apply(other_options)
    OVERWRITEABLE.each do |key|
      options[key] = other_options[key] if other_options.key?(key)
    end
  end

  # the repository/project checkout, ignoring any requested worktree
  def project_dir
    File.expand_path(options.fetch("dir") { Dir.pwd })
  end

  def dir
    worktree? ? worktree_dir : project_dir
  end

  def worktree
    options["worktree"]
  end

  def worktree?
    !worktree.to_s.empty?
  end

  # relative paths are resolved against the project directory
  def worktrees_dir
    configured = options["worktrees"] || DEFAULT_WORKTREES_DIR
    File.expand_path(configured, project_dir)
  end

  def worktree_dir
    File.join(worktrees_dir, path_safe(worktree))
  end

  # ref a newly created worktree branch starts from
  def from_ref
    options["from_ref"]
  end

  def abbr
    @abbr ||= options.fetch("abbr") { rand(0..0xffff).to_s(16) }
  end

  # tmux session name, kept distinct per worktree
  def session
    return abbr unless worktree?

    # tmux session names can't have dots (or :, but they don't survive path_safe)
    path_safe(worktree).tr(".", "_")
  end

  def names
    [abbr, key, *options.fetch("names", [])].compact.uniq
  end

  def windows
    [
      options.fetch("windows") { 1 },
      commands.count,
      labels.count
    ].max
  end

  def commands
    options.fetch("commands") { [] }
  end

  def labels
    options.fetch("labels") { [] }
  end

  def start
    options.fetch("start") { false }
  end

  def attach?
    !options["detach"]
  end

  def flake?
    options["flake"]
  end

  def tmux_cmd(*args)
    return nix_shell_tmux(*args) if options["flake"]

    box = options.fetch("distrobox", "")
    return ["tmux", *args].join(" ") if box.empty?

    tmux_parts = ["tmux -S ~/.local/share/tmux-#{box}.sock", *args].join(" ")
    "distrobox-enter #{box} -- #{tmux_parts}"
  end

  def nix_shell_tmux(*args)
    [
      "nix", "shell",
      %{--file "#{File.join(dir, 'flake.nix')}"},
      "--command tmux", *args
    ].join(" ")
  end

  # branch names may contain characters that are illegal in (or imply nested)
  # path names, so flatten them all down to underscores
  def path_safe(name)
    name.gsub(%r{[^A-Za-z0-9._-]}, "_").sub(/\A[.-]+/) { |run| "_" * run.length }
  end
end

def parse_options(argv)
  options = {}
  args = OptionParser.new do |op|
    op.banner = "Usage: tproj [options] [project_name] [dir]"

    op.on("-a ABBR", "--abbr ABBR", "Abbreviation for project. Used as tmux session name.") do |abbr|
      options["abbr"] = abbr
    end

    op.on("-d DIR", "--dir DIR", "Project working directory") do |dir|
      options["dir"] = dir
    end

    op.on("-w WINDOWS", "--windows WINDOWS", Integer, "Number of tmux windows in project") do |windows|
      options["windows"] = [windows, 1].max
    end

    op.on("-b BRANCH", "--worktree BRANCH", "Create/switch to a git worktree for BRANCH and session it there") do |branch|
      options["worktree"] = branch
    end

    op.on("--worktrees-dir DIR", "Where worktrees live (default: #{Project::DEFAULT_WORKTREES_DIR}, relative to the project dir)") do |dir|
      options["worktrees"] = dir
    end

    op.on("--from-ref REF", "When creating a new worktree+branch, the branch/ref to branch from") do |ref|
      options["from_ref"] = ref
    end

    op.on("--[no-]start", "Overrides project start option for pre-filled commands") do |start|
      options["start"] = start
    end

    op.on("-x [DISTROBOX]", "--distrobox [DISTROBOX]", "Create tmux session within specified distrobox. If blank, run on host (no distrobox).") do |distrobox|
      options["distrobox"] = distrobox
    end

    op.on("--detach", "Do not attach to the created tmux session") do
      options["detach"] = true
    end

    op.on("--flake", "Attempt to use flake.nix inside project directory via nix shell") do
      options["flake"] = true
    end

    op.on("--debug", "Enable debug output") do
      $debug = true
    end

    # useful if session needs to wait for difficult to status services
    op.on("--delay SECONDS", Float, "Number of seconds to wait before starting session") do |seconds|
      sleep seconds
    end

    op.on("-h", "--help") do
      puts op
      puts example_usage
    end
  end.parse(argv)
  options["abbr"] = args.shift if args.any? && !options["abbr"]
  options["dir"] = args.shift if args.any? && !options["dir"]
  options
end

def host
  File.read('/etc/hostname').strip
rescue Errno::ENOENT
  require 'socket'
  Socket.gethostname
end

# listed by precedence, ascending
def project_config_paths
  [
    File.expand_path("~/.config/tproj.yml"),
    File.expand_path("~/.config/tproj.#{host}.yml")
  ].select { |path| File.exist? path }
end

def project_configs
  project_config_paths.map { |path| YAML.load_file(path) }.reduce(&:merge)
end

def projects
  project_configs.map { |key, config| Project.new(key, config) }
end

def create_project(abbr, dir, windows = 1, *_)
  windows = [windows.to_i, 1].max
  Project.new({
    "abbr"    => abbr,
    "dir"     => dir,
    "windows" => windows,
  })
end

def find_project(name)
  projects.each do |project|
    return project if project.names.member?(name)
  end
  nil
end

def fatal_error(msg, exit_status = 1)
  STDERR.puts msg
  exit exit_status
end

def debug?
  $debug
end

def find_existing_sessions(proj)
  cmd = proj.tmux_cmd("list-sessions")
  puts "$ #{cmd}" if debug?
  stdout, _stderr, status = Open3.capture3(cmd)
  if status.success?
    stdout.split("\n").map {|line| line.split(":").first }
  else
    puts "Error: #{_stderr}"
    []
  end
end

def git(dir, *args)
  cmd = ["git", "-C", dir, *args]
  puts "$ #{cmd.join(' ')}" if debug?
  stdout, stderr, status = Open3.capture3(*cmd)
  [stdout.strip, stderr.strip, status.success?]
end

def local_ref_exists?(dir, ref)
  git(dir, "rev-parse", "--verify", "--quiet", ref).last
end

def remote_branch_exists?(dir, branch)
  git(dir, "for-each-ref", "--format=%(refname)", "refs/remotes/*/#{branch}").first.split("\n").any?
end

# Primary branch for the repo: what origin points its HEAD at, else the first
# conventional name that exists locally, else whatever the checkout is on.
def main_branch(dir)
  head, _stderr, success = git(dir, "symbolic-ref", "--short", "refs/remotes/origin/HEAD")
  return head.split("/", 2).last if success && !head.empty?

  conventional = %w[main master trunk].find { |name| local_ref_exists?(dir, "refs/heads/#{name}") }
  return conventional if conventional

  current, _stderr, success = git(dir, "rev-parse", "--abbrev-ref", "HEAD")
  success && !current.empty? ? current : "HEAD"
end

# Ensure the worktree for the requested branch exists, creating the branch too
# when it is not already known locally or on a remote.
def ensure_worktree(proj)
  return unless proj.worktree?
  return if Dir.exist?(proj.worktree_dir)

  branch, root = proj.worktree, proj.project_dir
  fatal_error "Not a git repository: #{root}" unless local_ref_exists?(root, "HEAD")

  known = local_ref_exists?(root, "refs/heads/#{branch}") || remote_branch_exists?(root, branch)

  FileUtils.mkdir_p(File.dirname(proj.worktree_dir))

  args = if known
    ["worktree", "add", proj.worktree_dir, branch]
  else
    from_ref = proj.from_ref.to_s
    from_ref = main_branch(root) if from_ref.empty?
    ["worktree", "add", "-b", branch, proj.worktree_dir, from_ref]
  end
  _stdout, stderr, success = git(root, *args)
  fatal_error "Could not start worktree for #{branch}:\n#{stderr}" unless success
  puts "Started worktree for #{branch} at #{proj.worktree_dir}"
end

def example_usage
  puts <<~HELPTEXT
    Examples:

      $ tproj project-name
      $ tproj abbr path/to/project
      $ tproj --distrobox=arch-asdf --windows=5 my-project
      $ tproj --abbr=acab --dir=projects/police-brutality --windows=2
      $ tproj dotbox --worktree=feature/thing
      $ tproj dotbox -b bugfix --worktrees-dir=~/worktrees/dotbox

    Pre-configured projects: #{projects.map(&:abbr).join(', ')}
  HELPTEXT
  exit
end

def find_or_create_project(options)
  return unless options["abbr"]

  # see if it already exists
  if project = find_project(options["abbr"])
    project.apply(options) # merge stored config with any runtime options
    return project
  end

  # if we have any of these options besides just abbr
  if %w[dir distrobox windows worktree].any? { |key| options[key] }
    Project.new(options)
  end
end

def set_terminal_title(title)
  print "\033]0;#{title}\007"
end

def run(cmd)
  puts "$ #{cmd}" if debug?
  system cmd
end

# Convert a command into a set of tmux send-keys values
def keys_escape(cmd)
  # encapsulate in quotes and quote existing quotes
  cmd.inspect
end

options = parse_options(ARGV)

current = find_or_create_project(options)
example_usage unless current
current.apply(options)

set_terminal_title("tmux: #{current.session}")

if find_existing_sessions(current).member?(current.session)
  cmd = current.tmux_cmd("attach -t #{current.session}")
  puts "> #{cmd}" if debug?
  exec cmd
  # ^ replaces process, so execution stops there
end

ensure_worktree(current)

# start building up a new tmux session
run current.tmux_cmd("new -s #{current.session} -c #{current.dir} -d")
delayed = []
1.step(to: current.windows) do |n|
  cmd, label = current.commands[n - 1], current.labels[n - 1]
  run current.tmux_cmd("new-window -t #{current.session} -c #{current.dir}") unless n == 1
  if cmd
    tmux_cmd_parts = [
      "send-keys",
      "-t",
      "#{current.session}:#{n}",
      keys_escape(cmd),
    ]
    tmux_cmd_parts << "Enter" if cmd && current.start
    full_tmux_cmd = current.tmux_cmd(*tmux_cmd_parts)
    puts "DELAYED$ #{full_tmux_cmd}" if debug?
    delayed << full_tmux_cmd
  end
  if label
    run current.tmux_cmd("rename-window -t #{current.session}:#{n}", label)
  end
end

if delayed.any?
  sleep 1 # give shell a chance so prompt is drawn before keys
  delayed.each { |cmd| system(*cmd) }
end

# move back to first window in case we aren't there anymore
run current.tmux_cmd("select-window -t #{current.session}:1")
# finally, attach to the new session
if current.attach?
  cmd = current.tmux_cmd("attach -t #{current.session}")
  puts "> #{cmd}" if debug?
  exec cmd
end
