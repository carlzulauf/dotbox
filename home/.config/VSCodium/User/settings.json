{
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "update.showReleaseNotes": false,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "workbench.startupEditor": "none",
  "explorer.autoReveal": false,
  "editor.tabSize": 2,
  "continue.enableNextEdit": true,
  "explorer.confirmDelete": false,
  "git.enableSmartCommit": true,
  "editor.rulers": [
    80, 100, 120
  ],
  "git.confirmSync": false,
  "files.exclude": {
    "test/vcr_cassettes": true
  },
  // Used only by workspaces that set rubyLsp.rubyVersionManager to "custom".
  // This setting is machine-scoped (global), so the per-project logic lives in
  // the fish function instead: ~/.config/fish/functions/ruby_lsp_activate.fish
  "rubyLsp.customRubyCommand": "ruby_lsp_activate",
  "rewrap.wrappingColumn": 80,
  // Code Spell Checker (streetsidesoftware.code-spell-checker), pinned in
  // nix/includes/gui.nix. Default is to check every file type, which is noisy
  // in code, so opt in per language instead.
  "cSpell.checkOnlyEnabledFileTypes": true,
  "cSpell.enabledFileTypes": {
    "*": false,
    "markdown": true,
    "plaintext": true,
    "git-commit": true
  },
  "cSpell.userWords": [],
  "[ruby]": {
    // turn off when doing merge conflicts to avoid unrelated changes
    "editor.formatOnSave": true,
    "editor.formatOnType": true
  }
}
