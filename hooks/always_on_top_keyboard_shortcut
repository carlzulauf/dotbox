#!/usr/bin/env ruby

require 'open3'

class Script
  def call
    if !gnome_installed?
      print "Skipped, GNOME not detected"
    elsif gsettings_installed?
      install_via_gsettings
    else
      print "Missing prerequisites"
    end
  end

  private

  def run?(cmd)
    _stdout, _stderr, status = Open3.capture3(cmd)
    status.success?
  end

  # Searches PATH directly; `which` isn't always installed.
  def installed?(name)
    ENV.fetch("PATH", "").split(File::PATH_SEPARATOR).any? do |dir|
      File.executable?(File.join(dir, name))
    end
  end

  def gnome_installed?
    installed?("gnome-shell")
  end

  def gsettings_installed?
    installed?("gsettings")
  end

  def install_via_gsettings
    cmd = %{gsettings set org.gnome.desktop.wm.keybindings always-on-top "['<Ctrl><Super>t']"}
    if run?(cmd)
      print "Installed"
    else
      fail "Install failed"
    end
  end
end

Script.new.()
