#!/usr/bin/env ruby

# === Bump nix/pkgs/t3code-desktop to a T3 Code release ===
# Reads the version and AppImage sha512 from the release's latest-linux.yml
# (electron-builder's update manifest), so nothing large is downloaded, and
# rewrites them in default.nix.
#
# Usage:
#   nix/pkgs/t3code-desktop/update            # latest stable release
#   nix/pkgs/t3code-desktop/update 0.1.5      # a specific release
#   nix/pkgs/t3code-desktop/update --check    # show what would change

require "open-uri"
require "yaml"

REPO = "pingdotgg/t3code"
NIX_FILE = File.join(__dir__, "default.nix")

check = ARGV.delete("--check")
wanted = ARGV.shift&.delete_prefix("v")

manifest_url =
  if wanted
    "https://github.com/#{REPO}/releases/download/v#{wanted}/latest-linux.yml"
  else
    "https://github.com/#{REPO}/releases/latest/download/latest-linux.yml"
  end

manifest =
  begin
    YAML.safe_load(URI.open(manifest_url).read)
  rescue OpenURI::HTTPError => e
    abort "Couldn't fetch #{manifest_url}: #{e.message}"
  end
version = manifest.fetch("version")
appimage = manifest.fetch("files").find { |f| f["url"].end_with?("-x86_64.AppImage") } or
  abort "No x86_64 AppImage in #{manifest_url}"
expected_name = "T3-Code-#{version}-x86_64.AppImage"
appimage["url"] == expected_name or
  abort "Unexpected AppImage name #{appimage['url']} (default.nix builds #{expected_name})"
hash = "sha512-#{appimage.fetch('sha512')}"

nix = File.read(NIX_FILE)
current = nix[/^  version = "([^"]+)";$/, 1] or abort "No version in #{NIX_FILE}"

if current == version && nix.include?(%(hash = "#{hash}";))
  puts "t3code-desktop is already at #{version}"
  exit
end

puts "t3code-desktop: #{current} -> #{version}"
exit if check

nix = nix.sub(/^  version = "[^"]+";$/) { %(  version = "#{version}";) }
nix = nix.sub(/^    hash = "[^"]+";$/) { %(    hash = "#{hash}";) }
File.write(NIX_FILE, nix)
