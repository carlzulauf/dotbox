Add a sensor_owner sysfs attribute and a post-probe auto-release to intel_cvs.

The CVS coprocessor owns the camera sensor's I2C bus at boot and the privacy
LED is wired to the CVS "req" GPIO, so it stays lit for as long as the host
holds the sensor.  Upstream intel_cvs acquires the sensor at probe and never
lets go, which means the choice is between a working camera with a
permanently-lit LED and no camera at all.

This adds:

  - a 10s auto-release after probe, leaving just enough time for dependent
    sensor drivers (ov02c10) to bind before the LED goes out, and
  - a sensor_owner attribute so userspace can take the sensor back when an
    application actually wants to capture:

        echo ipu > /sys/bus/i2c/devices/i2c-INTC10DE:00/sensor_owner
        echo cvs > /sys/bus/i2c/devices/i2c-INTC10DE:00/sensor_owner

Based on the patches osandum proposed in intel/vision-drivers#32, with the
sysfs writes made idempotent (the underlying helpers are refcounted) and the
device looked up through the driver's global rather than through
to_i2c_client(), which is wrong for the platform binding.

Upstream issue: https://github.com/intel/vision-drivers/issues/32

--- a/include/linux/intel_cvs.h	2026-08-18 19:51:18.192929155 -0600
+++ b/include/linux/intel_cvs.h	2026-08-18 19:51:50.537452609 -0600
@@ -159,6 +159,11 @@
 	int fw_dl_status_code;
 } __packed;
 
+/* Time the host keeps the sensor after probe, so dependent sensor
+ * drivers get a chance to bind before the privacy LED goes out.
+ */
+#define CVS_AUTO_RELEASE_MS 10000
+
 struct intel_cvs {
 	struct device *dev;
 	/* True when device was enumerated as an I2C client and all I2C
@@ -186,6 +191,7 @@
 	unsigned long long oem_prod_id;
 	enum cvs_camera_owner owner;
 	int int_ref_count;
+	struct delayed_work delayed_release;
 
 	/* FW update info */
 	struct work_struct fw_dl_task;
--- a/drivers/misc/icvs/intel_cvs.c	2026-08-18 19:51:18.192732324 -0600
+++ b/drivers/misc/icvs/intel_cvs.c	2026-08-18 19:51:50.537061337 -0600
@@ -20,6 +20,8 @@
 
 struct intel_cvs *cvs;
 
+static void cvs_delayed_release(struct work_struct *work);
+
 static irqreturn_t cvs_irq_handler(int irq, void *devid)
 {
 	struct intel_cvs *icvs = devid;
@@ -187,6 +189,17 @@
 	}
 
 	icvs->icvs_sensor_state = CV_SENSOR_VISION_ACQUIRED_STATE;
+
+	/*
+	 * The sensor is held so that dependent drivers (ov02c10) can probe,
+	 * but the privacy LED is wired to the CVS req GPIO and stays lit for
+	 * as long as we hold it.  Hand it back shortly after boot; userspace
+	 * re-acquires on demand via the sensor_owner attribute below.
+	 */
+	INIT_DELAYED_WORK(&icvs->delayed_release, cvs_delayed_release);
+	schedule_delayed_work(&icvs->delayed_release,
+			      msecs_to_jiffies(CVS_AUTO_RELEASE_MS));
+
 	acpi_dev_clear_dependencies(ACPI_COMPANION(icvs->dev));
 
 exit:
@@ -222,6 +235,10 @@
 		dev_info(dev, "%s (platform)\n", __func__);
 	}
 	if (icvs) {
+		cancel_delayed_work_sync(&icvs->delayed_release);
+		if (icvs->owner == CVS_CAMERA_IPU)
+			cvs_release_camera_sensor_internal();
+
 		cvs->close_fw_dl_task = true;
 
 		if (icvs->cap == ICVS_FULLCAP) {
@@ -370,6 +387,80 @@
 	return 0;
 }
 
+static void cvs_delayed_release(struct work_struct *work)
+{
+	struct intel_cvs *icvs =
+		container_of(work, struct intel_cvs, delayed_release.work);
+
+	if (icvs->owner != CVS_CAMERA_IPU)
+		return;
+
+	if (cvs_release_camera_sensor_internal())
+		dev_warn(icvs->dev, "%s:auto-release failed", __func__);
+	else
+		icvs->icvs_sensor_state = CV_SENSOR_RELEASED_STATE;
+}
+
+/*
+ * sensor_owner - who currently drives the camera sensor, "ipu" or "cvs".
+ *
+ * Writes are idempotent: asking for an owner that is already in effect is a
+ * no-op.  The underlying acquire/release helpers are refcounted, so a plain
+ * edge-triggered interface would leak a reference every time a script wrote
+ * "ipu" twice and leave the privacy LED stuck on.  The only other user of
+ * that refcount is the firmware update path, which acquires and releases in
+ * a matched pair; releasing from here during an update would drop its
+ * reference, so don't touch this attribute while flashing CVS firmware.
+ */
+static ssize_t sensor_owner_show(struct device *dev,
+				 struct device_attribute *attr, char *buf)
+{
+	struct intel_cvs *icvs = cvs;
+
+	if (!icvs)
+		return -ENODEV;
+
+	return sysfs_emit(buf, "%s\n",
+			  icvs->owner == CVS_CAMERA_IPU ? "ipu" : "cvs");
+}
+
+static ssize_t sensor_owner_store(struct device *dev,
+				  struct device_attribute *attr,
+				  const char *buf, size_t count)
+{
+	struct intel_cvs *icvs = cvs;
+	int ret;
+
+	if (!icvs)
+		return -ENODEV;
+
+	cancel_delayed_work_sync(&icvs->delayed_release);
+
+	if (sysfs_streq(buf, "ipu")) {
+		if (icvs->owner == CVS_CAMERA_IPU)
+			return count;
+
+		ret = cvs_acquire_camera_sensor_internal();
+		if (ret)
+			return ret;
+		icvs->icvs_sensor_state = CV_SENSOR_VISION_ACQUIRED_STATE;
+	} else if (sysfs_streq(buf, "cvs")) {
+		if (icvs->owner == CVS_CAMERA_CVS)
+			return count;
+
+		ret = cvs_release_camera_sensor_internal();
+		if (ret)
+			return ret;
+		icvs->icvs_sensor_state = CV_SENSOR_RELEASED_STATE;
+	} else {
+		return -EINVAL;
+	}
+
+	return count;
+}
+
+static DEVICE_ATTR_RW(sensor_owner);
+
 #ifdef DEBUG_CVS
 enum cvs_state cvs_state;
 int cvs_exec_cmd(enum cvs_command command)
@@ -640,6 +731,7 @@
 #endif
 	&dev_attr_cvs_ctrl_data_pre.attr,
 	&dev_attr_cvs_ctrl_data_fwupd.attr,
+	&dev_attr_sensor_owner.attr,
 	NULL,
 };
 ATTRIBUTE_GROUPS(cvs);
