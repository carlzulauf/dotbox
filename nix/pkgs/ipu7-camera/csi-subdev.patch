diff -ruN -x intel_cvs_csi.c base/drivers/misc/icvs/intel_cvs.c work/drivers/misc/icvs/intel_cvs.c
--- a/drivers/misc/icvs/intel_cvs.c	2026-08-20 10:00:50.969460086 -0600
+++ b/drivers/misc/icvs/intel_cvs.c	2026-08-20 10:02:30.491770946 -0600
@@ -202,6 +202,13 @@
 
 	acpi_dev_clear_dependencies(ACPI_COMPANION(icvs->dev));
 
+	/*
+	 * ipu-bridge wires this device into the camera fwnode graph from
+	 * intel_ipu7's probe, which cannot run until we exist -- so the
+	 * graph is never ready yet here.  cvs_csi_register() waits for it.
+	 */
+	cvs_csi_register(icvs->dev);
+
 exit:
 	if (ret)
 		devm_kfree(icvs->dev, icvs);
@@ -235,6 +242,7 @@
 		dev_info(dev, "%s (platform)\n", __func__);
 	}
 	if (icvs) {
+		cvs_csi_unregister(dev);
 		cancel_delayed_work_sync(&icvs->delayed_release);
 		if (icvs->owner == CVS_CAMERA_IPU)
 			cvs_release_camera_sensor_internal();
