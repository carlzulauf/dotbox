# Virtual hardware for nirvm, a QEMU/KVM guest under libvirt (see bin/nirvm).
#
# Written by hand rather than generated by nixos-generate-config: the disk
# layout comes from disk-image.nix, which also builds the bootable qcow2 that
# bin/nirvm imports (config.system.build.image), so the image and the config
# that boots it can't disagree.
{ config, lib, modulesPath, ... }:

{
  imports = [
    "${modulesPath}/profiles/qemu-guest.nix"
    "${modulesPath}/virtualisation/disk-image.nix"
  ];

  # disk-image.nix provides / (label "nixos", ext4) and /boot (label "ESP"),
  # and enables boot.growPartition plus autoResize on /. The image is built
  # with only a little free space; bin/nirvm grows the qcow2 to its real size
  # and the first boot grows the partition and filesystem to match.
  image.baseName = "nirvm";

  # The image is assembled in a build VM with no EFI variables to write.
  # bootctl installs the removable-media path (EFI/BOOT/BOOTX64.EFI) either
  # way, which is what OVMF boots on a fresh NVRAM.
  boot.loader.efi.canTouchEfiVariables = lib.mkForce false;

  nixpkgs.hostPlatform = lib.mkDefault "x86_64-linux";
}
