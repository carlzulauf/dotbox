#!/usr/bin/env ruby

# === NixOS Configuration Installer ===
# Rebuilds NixOS straight from the flake in this checkout's nix/ directory,
# after syncing the machine-local files the flake needs into it.
#
# Usage (from dotbox dir):
#   bin/install_nix [options] [hostname]
#
# Options:
#   -s, --switch                Rebuild in 'switch' mode (active immediately)
#   -b, --boot                  Rebuild in 'boot' mode (active next boot)
#   -u, --upgrade, --update     Bump nix/pkgs with update scripts, update
#                               flake.lock, and rebuild
#   -r, --rebuild               Run nixos-rebuild after copying configs
#       --no-rebuild            Disable rebuild, and the flake update with it
#                               (wins over every other option, in any order)
#   -g, --gc[=SPEC]             Run cleanup-nixos after a successful rebuild.
#                               SPEC must be attached (--gc=30d, -g+3); with no
#                               SPEC, cleanup-nixos uses configurationLimit.
#       --build-host=HOST       Remote builder for derivation evaluation.
#                               Connects as you (no root login needed); HOST
#                               just has to have you in its
#                               nix.settings.trusted-users.
#       --nax                   Shorthand for --build-host=nax
#       --hostname=NAME         Specify machine to build (default: `hostname`)
#   -j, --jobs, --max-jobs=N    Limit nix to N concurrent build jobs
#       --cores=N               Limit each build job to N cores
#   -h, --help                  Show this help message
#
#
# The flake only sees files git tracks, so new files under nix/ have to be
# `git add`ed first. Files this script adds to nix/ are staged for you.
#
# Requirements:
#   - ruby
#   - git
#   - nix (flake commands)
#   - sudo access
#   - cleanup-nixos (home/.local/bin), only when --gc is used

require 'fileutils'
require 'optparse'

class Script
  def self.default_options
    {
      upgrade:      false,
      rebuild:      false,
      gc:           nil,
      build_host:   nil,
      max_jobs:     nil,
      cores:        nil,
      rebuild_type: "boot",
      host:         default_host,
      config_dir:   dotbox_config_dir
    }
  end

  def self.dotbox_config_dir
    File.expand_path(File.join(File.dirname(__FILE__), "..", "nix"))
  end

  def self.default_host
    `hostname`.strip
  end

  # Packages in nix/pkgs that pin an upstream release and have an `update`
  # script to bump it, run by --upgrade.
  def self.updatable_packages
    %w[t3code-desktop open-vsx-extensions]
  end

  # Prefer the copy in this repo so --gc works before dotfiles are installed.
  def self.cleanup_nixos_bin
    local = File.expand_path(File.join(File.dirname(__FILE__), "..", "home", ".local", "bin", "cleanup-nixos"))
    File.exist?(local) ? local : "cleanup-nixos"
  end

  def self.start(argv)
    new(argv).()
  end

  # A command to run, with an optional message printed once it succeeds.
  Command = Struct.new(:argv, :sudo, :notice) do
    def to_a
      sudo ? ["sudo", *argv] : argv
    end

    def to_s
      to_a.join(" ")
    end
  end

  attr_reader :options, :file_map

  def initialize(argv)
    @options = self.class.default_options.merge(parse_options(argv))
  end

  # Every command is planned before any of them run, so the whole list can be
  # shown up front. Nothing a later step checks is changed by an earlier one.
  def call
    commands = [
      sync_hardware_config,
      sync_puma_dev_ca,
      update_packages,
      nixos_rebuild,
      collect_garbage
    ].reduce(:+)
    print_plan(commands)
    keep_sudo_alive if rebuild
    commands.each { |command| run(command) }
    print_manual_steps unless rebuild
  end

  def command(*argv, sudo: false, notice: nil)
    Command.new(argv, sudo, notice)
  end

  def print_plan(commands)
    puts "Commands to run:"
    commands.each { |command| puts " $ #{command}" }
    puts
  end

  def run(command)
    status = system(*command.to_a)
    unless status
      puts "Command failed: #{command.to_a}"
      exit 1
    end
    puts command.notice if command.notice
  end

  # Builds run as you, and only activation needs root. Prompt for sudo once up
  # front (or not at all if the ticket is still fresh), then keep refreshing
  # the ticket in the background so that the sudo for activation after a long
  # build never re-prompts.
  # `sudo -n -v` never prompts; it just extends the existing ticket.
  def keep_sudo_alive
    run command("--validate", sudo: true)

    Thread.new do
      loop do
        sleep 60
        system("sudo", "--non-interactive", "--validate", out: File::NULL, err: File::NULL)
      end
    end
  end

  # Each machine's hardware-configuration.nix is generated in /etc/nixos and
  # checked into the repo as nix/hardware/<host>.nix, which the flake builds
  # with. The /etc/nixos copy wins, and replaces the repo copy when that is
  # missing or different. Only done for the machine being installed on, and
  # never for generic, which is installed on whatever hardware is at hand.
  def sync_hardware_config
    return [] if host != self.class.default_host || host == "generic"

    installed = "/etc/nixos/hardware-configuration.nix"
    return [] unless File.exist?(installed)
    return [] if File.exist?(hardware_config) && FileUtils.compare_file(installed, hardware_config)

    track(installed, hardware_config)
  end

  def hardware_config
    File.join(config_dir, "hardware", "#{host}.nix")
  end

  # Hosts without a checked-in hardware config (generic, or another machine's
  # not checked in yet) build with /etc/nixos/hardware-configuration.nix,
  # which pure evaluation can't read.
  def impure?
    !File.exist?(hardware_config) && sync_hardware_config.empty?
  end

  # Copy a machine-local file into the repo, and stage it when it is new, so
  # the flake can see it.
  def track(source, tracked)
    tracked_dir = File.dirname(tracked)
    [
      *(File.directory?(tracked_dir) ? [] : [command("mkdir", "-p", tracked_dir)]),
      command("cp", source, tracked, notice: "Updated #{tracked} from #{source}; commit it to the repo."),
      *(git_tracked?(tracked) ? [] : [command("git", "-C", config_dir, "add", tracked)]),
    ]
  end

  def git_tracked?(path)
    system("git", "-C", config_dir, "ls-files", "--error-unmatch", path, out: File::NULL, err: File::NULL)
  end

  # puma-dev's CA lives in ~/.puma-dev-ssl, generated on each machine by
  # bin/puma_dev_ca, so its key never enters the Nix store or leaves the
  # machine. Its public cert is checked into the repo as nix/puma-dev/<host>.pem,
  # which the flake trusts. The ~/.puma-dev-ssl copy wins, and replaces the repo
  # copy when that is missing or different. Like the hardware config, only done
  # for the machine being installed on, and only when its machine config
  # enables puma-dev.
  def sync_puma_dev_ca
    return [] if host != self.class.default_host || host == "generic"

    machine = File.join(config_dir, "machines", "#{host}.nix")
    return [] unless File.exist?(machine) && File.read(machine).include?("services.puma-dev")

    ssl_dir = File.expand_path("~/.puma-dev-ssl")
    cert = File.join(ssl_dir, "cert.pem")
    tracked = File.join(config_dir, "puma-dev", "#{host}.pem")

    if puma_dev_ca_usable?(ssl_dir)
      return [] if File.exist?(tracked) && FileUtils.compare_file(cert, tracked)

      track(cert, tracked)
    else
      [
        command(File.expand_path("puma_dev_ca", __dir__), "--force", ssl_dir, host),
        *track(cert, tracked),
      ]
    end
  end

  # A CA is replaced when either half is missing, they don't match, or it is
  # one the old puma-dev flake generated in the Nix store (subject exactly
  # "puma-dev CA"), whose private key is world-readable there.
  def puma_dev_ca_usable?(ssl_dir)
    key_path = File.join(ssl_dir, "key.pem")
    cert_path = File.join(ssl_dir, "cert.pem")
    return false unless File.exist?(key_path) && File.exist?(cert_path)

    require 'openssl'
    cert = OpenSSL::X509::Certificate.new(File.read(cert_path))
    key = OpenSSL::PKey.read(File.read(key_path))
    cert.subject.to_s != "/CN=puma-dev CA" && cert.check_private_key(key)
  end

  # Bump the packages in nix/pkgs before the rebuild. Like the flake update,
  # this only runs with a rebuild, so every bump gets built (a failed build
  # leaves the bump in the repo, to fix or revert).
  def update_packages
    return [] unless rebuild && upgrade

    package_update_commands
  end

  # The scripts rewrite their package's files in config_dir, so no sudo.
  def package_update_commands
    self.class.updatable_packages.map do |package|
      command(File.join(config_dir, "pkgs", package, "update"))
    end
  end

  def nixos_rebuild
    return [] unless rebuild

    [
      # Only updated with a rebuild, so every update gets built.
      *(upgrade ? [flake_update_command] : []),
      rebuild_command,
    ]
  end

  def flake_update_command
    command("nix", "flake", "update", "--flake", config_dir)
  end

  # Runs as you, so the flake is evaluated by its owner (git refuses a repo
  # owned by someone else) and a --build-host is reached over your ssh, not
  # root's. --elevate=sudo has nixos-rebuild sudo only for activation, reusing
  # the ticket kept fresh by keep_sudo_alive. The build host only has to have
  # you in its nix.settings.trusted-users.
  def rebuild_command
    cmd_options = ["--log-format", "bar-with-logs", "--flake", "#{config_dir}##{host}", "--elevate=sudo"]
    cmd_options << "--impure" if impure?
    cmd_options << "--build-host" << build_host if build_host
    cmd_options << "--max-jobs" << max_jobs.to_s if max_jobs
    cmd_options << "--cores" << cores.to_s if cores
    command("nixos-rebuild", *cmd_options, rebuild_type)
  end

  # Without a rebuild, show the commands that would have followed instead.
  def print_manual_steps
    prompt = ->(cmd) { "#{cmd.sudo ? '#' : '$'} #{cmd.argv.join(' ')}" }
    package_update_commands.each { |cmd| puts "Update package: #{prompt.(cmd)}" }
    puts "Update flake: #{prompt.(flake_update_command)}"
    puts "Rebuild NixOS: #{prompt.(rebuild_command)}"
    puts "Collect garbage: $ #{garbage_command.argv.join(' ')}" unless gc.nil?
  end

  # Runs last: the rebuild has already added a generation, so trimming to the
  # newest N here leaves exactly N with boot entries. cleanup-nixos sudos itself.
  #
  # That rebuild also left the ESP holding exactly configurationLimit entries,
  # which is what a bare --gc trims to -- so the generations it deletes have no
  # entries left to strand. Anything else (a tighter SPEC, or no rebuild at all)
  # can strand them, and needs cleanup-nixos to reinstall the boot loader.
  def collect_garbage
    return [] if gc.nil? || !rebuild

    [garbage_command]
  end

  def garbage_command
    reconciled = rebuild && gc == :auto
    command(*[
      self.class.cleanup_nixos_bin,
      "--summary",
      reconciled ? nil : "--boot-sync",
      gc == :auto ? nil : gc,
    ].compact)
  end

  def parse_options(argv)
    no_rebuild = false

    {}.tap do |parsed|
      remainders = OptionParser.new do |op|
        op.on("--upgrade", "--update", "-u", "Upgrade: bump nix/pkgs with update scripts, update every input in flake.lock, then rebuild") do
          parsed[:upgrade] = true
          parsed[:rebuild] = true
        end

        op.on("--rebuild", "-r", "Run nixos-rebuild command after installing") do
          parsed[:rebuild] = true
        end

        # Applied after parsing, so it wins whatever order the options come in.
        op.on("--no-rebuild", "Do not rebuild nixos after installing configs. Overrides any other setting.") do
          no_rebuild = true
        end

        # SPEC must be attached (--gc=30d, -g+3); bare --gc defers to configurationLimit.
        op.on("--gc[=SPEC]", "-g", "Run cleanup-nixos after a successful rebuild. Defaults to configurationLimit.") do |spec|
          parsed[:gc] = spec || :auto
        end

        op.on("--switch", "-s", "Run nixos-rebuild in 'switch' mode to immediately switch to generation after building") do
          parsed[:rebuild] = true
          parsed[:rebuild_type] = "switch"
        end

        op.on("--boot", "-b", "Run nixos-rebuild in 'boot' mode to build for the next boot") do
          parsed[:rebuild] = true
          parsed[:rebuild_type] = "boot"
        end

        op.on("--nax", "Add '--build-host nax' option to nixos-rebuild") do
          parsed[:rebuild] = true
          parsed[:build_host] = "nax"
        end

        op.on("--build-host=HOST", "Remote host to build nixos packages on. Defaults to empty (local).") do |host|
          parsed[:rebuild] = true
          parsed[:build_host] = host
        end

        op.on("-j N", "--jobs=N", "--max-jobs=N", Integer, "Limit nix to N concurrent build jobs (0 forces everything to build host).") do |jobs|
          parsed[:max_jobs] = jobs
        end

        op.on("--cores=N", Integer, "Limit each nix build job to N cores (0 means all available).") do |cores|
          parsed[:cores] = cores
        end

        op.on("--hostname=NAME", "Specify which nix machine to build (defaults to current hostname).") do |name|
          parsed[:host] = name
        end

        op.on("-h", "--help") do
          puts op
          exit
        end
      end.parse(argv)
      host = remainders.first
      parsed[:host] = host unless host.nil? || host.empty?
      parsed[:rebuild] = false if no_rebuild
    end
  end

  default_options.keys.each do |option|
    define_method(option) { options.fetch(option) }
    define_method("#{option}=") { |new_value| options[option] = new_value }
  end
end

Script.start(ARGV)
