#!/usr/bin/env ruby

# === NixOS Configuration Installer ===
# Copies local NixOS configuration files to the system installation path
# and optionally triggers a rebuild through nixos-rebuild.
#
# Usage (from dotbox dir):
#   bin/install_nix [options] [hostname]
#
# Options:
#   -s, --switch                Rebuild in 'switch' mode (active immediately)
#   -b, --boot                  Rebuild in 'boot' mode (active next boot)
#   -u, --upgrade, --update     Update flake.lock and rebuild
#   -r, --rebuild               Run nixos-rebuild after copying configs
#       --no-rebuild            Disable rebuild (overrides other settings)
#   -g, --gc[=SPEC]             Run cleanup-nixos after a successful rebuild.
#                               SPEC must be attached (--gc=30d, -g+3); with no
#                               SPEC, cleanup-nixos uses configurationLimit.
#       --build-host=HOST       Remote builder for derivation evaluation.
#                               Connects as the invoking user (no root login
#                               needed); HOST just has to have that user in its
#                               nix.settings.trusted-users.
#       --nax                   Shorthand for --build-host=nax
#       --hostname              Specify machine to build (default: `hostname`)
#   -j, --jobs, --max-jobs=N    Limit nix to N concurrent build jobs
#       --cores=N               Limit each build job to N cores
#   -h, --help                  Show this help message
#
#
# Configuration:
#   Config files are read from dotbox's `nix/`` directory.
#   Installs nix configs to /etc/nixos (requires sudo).
#
# Requirements:
#   - ruby
#   - rsync
#   - nix (flake commands)
#   - sudo access (configurable via --use-sudo/--no-use-sudo if needed)
#   - cleanup-nixos (home/.local/bin), only when --gc is used

require 'optparse'

class Script
  def self.default_options
    {
      use_sudo:     true,
      upgrade:      false,
      rebuild:      false,
      gc:           nil,
      build_host:   nil,
      max_jobs:     nil,
      cores:        nil,
      rebuild_type: "boot",
      install_path: "/etc/nixos",
      host:         default_host,
      config_dir:   dotbox_config_dir
    }
  end

  def self.dotbox_config_dir
    File.expand_path(File.join(File.dirname(__FILE__), "..", "nix"))
  end

  def self.default_host
    `hostname`.strip
  end

  # Prefer the copy in this repo so --gc works before dotfiles are installed.
  def self.cleanup_nixos_bin
    local = File.expand_path(File.join(File.dirname(__FILE__), "..", "home", ".local", "bin", "cleanup-nixos"))
    File.exist?(local) ? local : "cleanup-nixos"
  end

  def self.start(argv)
    new(argv).()
  end

  attr_reader :options, :file_map

  def initialize(argv)
    @options = self.class.default_options.merge(parse_options(argv))
  end

  def call
    copy_nix_files
    nixos_rebuild
    collect_garbage
  end

  def run(*cmd, sudo: false)
    cmd.prepend("sudo") if sudo
    puts " + #{cmd.join(' ')}"
    status = system(*cmd)
    unless status
      puts "Command failed: #{cmd}"
      exit
    end
  end

  def copy_nix_files
    %w[configuration.nix flake.nix flake.lock].each do |file|
      run "cp", File.join(config_dir, file), File.join(install_path, file), sudo: use_sudo
    end

    %w[includes machines pkgs].each do |dir|
      next unless File.exist?(File.join(config_dir, dir))

      run(
        "rsync", "--archive",
        File.join(config_dir, "#{dir}/"),
        File.join(install_path, dir),
        sudo: use_sudo
      )
    end
  end

  # `sudo nixos-rebuild` causes --build-host to ssh as root, which means /root
  # has to have ssh keys accepted by root@{build-host}, which is not ideal.
  #
  # When --build-host is present, we now run the command without sudo, but
  # --elevate=sudo --ask-elevate-password, so `nixos-rebuild` elevates as needed
  # to activate the newly built generation (via sudo), and ask the password
  # upfront so we hopefully don't timeout. The ssh to the build-host happens as
  # the current user, and the build host will still build to its store if the
  # user is in nix.settings.trusted-users
  def delegate_elevation?
    !build_host.nil? && use_sudo
  end

  def nixos_rebuild
    if upgrade
      run "nix", "flake", "update", "--flake", install_path, sudo: use_sudo
    end

    cmd_options = ["--log-format", "bar-with-logs", "--flake", "/etc/nixos##{host}"]
    cmd_options << "--build-host" << build_host if build_host
    cmd_options << "--max-jobs" << max_jobs.to_s if max_jobs
    cmd_options << "--cores" << cores.to_s if cores
    cmd_options << "--elevate=sudo" << "--ask-elevate-password" if delegate_elevation?
    rebuild_cmd = ["nixos-rebuild", *cmd_options, rebuild_type]
    rebuild_sudo = use_sudo && !delegate_elevation?

    if rebuild
      run(*rebuild_cmd, sudo: rebuild_sudo)
    else
      puts "Update flake: #{use_sudo ? '#' : '$'} nix flake update --flake #{install_path}"
      puts "Rebuild NixOS: #{rebuild_sudo ? '#' : '$'} #{rebuild_cmd.join(' ')}"
    end

    # capture the successful lock file if we get this far
    copy_lock_file if rebuild
  end

  def copy_lock_file
    run "cp", File.join(install_path, "flake.lock"), File.join(config_dir, "flake.lock")
  end

  # Runs last: the rebuild has already added a generation, so trimming to the
  # newest N here leaves exactly N with boot entries. cleanup-nixos sudos itself.
  #
  # That rebuild also left the ESP holding exactly configurationLimit entries,
  # which is what a bare --gc trims to -- so the generations it deletes have no
  # entries left to strand. Anything else (a tighter SPEC, or no rebuild at all)
  # can strand them, and needs cleanup-nixos to reinstall the boot loader.
  def collect_garbage
    return if gc.nil?

    reconciled = rebuild && gc == :auto
    parts = [
      self.class.cleanup_nixos_bin,
      reconciled ? nil : "--boot-sync",
      gc == :auto ? nil : gc,
    ].compact

    unless rebuild
      puts "Collect garbage: $ #{parts.join(' ')}"
      return
    end

    run(*parts)
  end

  def parse_options(argv)
    {}.tap do |parsed|
      remainders = OptionParser.new do |op|
        op.on("--upgrade", "--update", "-u", "Update system flake and run nixos-rebuild with '--upgrade'") do
          parsed[:upgrade] = true
          parsed[:rebuild] = true
        end

        op.on("--rebuild", "-r", "Run nixos-rebuild command after installing") do
          parsed[:rebuild] = true
        end

        op.on("--no-rebuild", "Do not rebuild nixos after installing configs. Overrides any other setting.") do
          parsed[:rebuild] = false
        end

        # SPEC must be attached (--gc=30d, -g+3); bare --gc defers to configurationLimit.
        op.on("--gc[=SPEC]", "-g", "Run cleanup-nixos after a successful rebuild. Defaults to configurationLimit.") do |spec|
          parsed[:gc] = spec || :auto
        end

        op.on("--switch", "-s", "Run nixos-rebuild in 'switch' mode to immediately switch to generation after building") do
          parsed[:rebuild] = true
          parsed[:rebuild_type] = "switch"
        end

        op.on("--boot", "-b", "Run nixos-rebuild in 'boot' mode to build for the next boot") do
          parsed[:rebuild] = true
          parsed[:rebuild_type] = "boot"
        end

        op.on("--nax", "Add '--build-host nax' option to nixos-rebuild") do
          parsed[:rebuild] = true
          parsed[:build_host] = "nax"
        end

        op.on("--build-host=HOST", "Remote host to build nixos packages on. Defaults to empty (local).") do |host|
          parsed[:rebuild] = true
          parsed[:build_host] = host
        end

        op.on("-j N", "--jobs=N", "--max-jobs=N", Integer, "Limit nix to N concurrent build jobs (0 forces everything to build host).") do |jobs|
          parsed[:max_jobs] = jobs
        end

        op.on("--cores=N", Integer, "Limit each nix build job to N cores (0 means all available).") do |cores|
          parsed[:cores] = cores
        end

        op.on("--hostname", "Specify which nix machine to build (defaults to current hostname).") do |name|
          parsed[:host] = name
        end

        op.on("-h", "--help") do
          puts op
          exit
        end
      end.parse(argv)
      host = remainders.first
      parsed[:host] = host unless host.nil? || host.empty?
    end
  end

  default_options.keys.each do |option|
    define_method(option) { options.fetch(option) }
    define_method("#{option}=") { |new_value| options[option] = new_value }
  end
end

Script.start(ARGV)
